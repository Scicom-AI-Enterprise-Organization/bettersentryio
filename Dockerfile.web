# The operator UI. Separate image from the engine on purpose (PLAN D11a): the engine is a
# 17MB static binary with one dependency, and nothing about Node should be able to make it
# bigger or slower to start.
#
# next.config sets `output: "standalone"`, so the runtime stage needs only the traced
# server bundle — not node_modules, not the source. That is also why `next start` warns
# locally: standalone expects `node server.js`, which is what the CMD below does.

FROM --platform=$BUILDPLATFORM node:22-trixie-slim AS deps
WORKDIR /app
# Prisma's postinstall needs the schema present, so copy it with the manifests rather than
# after — otherwise `prisma generate` runs against nothing and the client is missing at build.
COPY web/package.json web/package-lock.json ./
COPY web/prisma ./prisma
RUN npm ci --no-audit --no-fund

FROM --platform=$BUILDPLATFORM node:22-trixie-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
ARG APP_VERSION=dev
ENV NEXT_PUBLIC_APP_VERSION=$APP_VERSION
# Auth.js and Prisma read env at module load, so a build needs *something* in these — but
# nothing real. Scoped to this one RUN rather than set with ENV: image metadata should not
# carry credential-shaped values at all, even placeholders (buildkit's
# SecretsUsedInArgOrEnv check is right to flag that), and the runtime stage must inherit
# nothing, so a missing SealedSecret makes the app fail loudly instead of starting with a
# placeholder AUTH_SECRET.
RUN AUTH_SECRET=build-only-never-used-at-runtime \
    AUTH_URL=http://localhost:3000 \
    DATABASE_URL='postgres://placeholder:placeholder@localhost:5432/placeholder?schema=auth' \
    sh -c 'npx prisma generate && npm run build'
# The runtime is distroless: no shell and no `openssl` binary, so Prisma's OpenSSL probe would
# fail and fall back to "1.1.x" (the trap the old runtime solved by installing openssl). Pick
# the engine for the target architecture here, where there is a shell, and point Prisma at
# it with PRISMA_QUERY_ENGINE_LIBRARY so nothing has to be probed at runtime.
ARG TARGETARCH
RUN case "${TARGETARCH:-amd64}" in \
      arm64) t=linux-arm64-openssl-3.0.x ;; \
      *)     t=debian-openssl-3.0.x ;; \
    esac \
    && cp "node_modules/.prisma/client/libquery_engine-$t.so.node" /app/query-engine.so.node \
    && mkdir -p /app/.next-cache

# Google distroless: no shell, no package manager, non-root UID 65532. Debian 13 carries
# libssl.so.3 / libcrypto.so.3 (the OpenSSL 3 engine needs them) and the CA bundle.
FROM gcr.io/distroless/nodejs22-debian13:nonroot AS runtime
# Build the filesystem as root so /app and the code are not writable by the runtime user
# (BuildKit creates WORKDIR as the current user, which is 65532 in a :nonroot base).
USER 0
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    PRISMA_QUERY_ENGINE_LIBRARY=/app/query-engine.so.node
# The standalone bundle, plus the two asset trees it does not trace.
# Code and assets stay owned by root, so the runtime user cannot modify them. Only the
# (empty) .next/cache, where Next.js writes its cache, belongs to UID 65532.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build --chown=65532:65532 /app/.next-cache ./.next/cache
COPY --from=build /app/public ./public
# Prisma schema + migrations (for reference; the image cannot run the Prisma CLI: see
# deploy/eks/README.md for the bootstrap). Client and the one engine this arch needs.
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=build /app/query-engine.so.node /app/query-engine.so.node

EXPOSE 3000
# The entrypoint is already node, so CMD is only the script.
USER 65532:65532
CMD ["server.js"]
