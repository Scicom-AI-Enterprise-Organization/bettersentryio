# The operator UI. Separate image from the engine on purpose (PLAN D11a): the engine is a
# 17MB static binary with one dependency, and nothing about Node should be able to make it
# bigger or slower to start.
#
# next.config sets `output: "standalone"`, so the runtime stage needs only the traced
# server bundle — not node_modules, not the source. That is also why `next start` warns
# locally: standalone expects `node server.js`, which is what the CMD below does.

FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS deps
WORKDIR /app
# Prisma's postinstall needs the schema present, so copy it with the manifests rather than
# after — otherwise `prisma generate` runs against nothing and the client is missing at build.
COPY web/package.json web/package-lock.json ./
COPY web/prisma ./prisma
RUN npm ci --no-audit --no-fund

FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
ARG APP_VERSION=dev
ENV NEXT_PUBLIC_APP_VERSION=$APP_VERSION
# Auth.js and Prisma read env at module load, so a build needs *something* in these — but
# nothing real. Scoped to this one RUN rather than set with ENV: image metadata should not
# carry credential-shaped values at all, even placeholders (buildkit's
# SecretsUsedInArgOrEnv check is right to flag that), and the runtime stage must inherit
# nothing, so a missing SealedSecret makes the app fail loudly instead of starting with a
# placeholder AUTH_SECRET.
RUN AUTH_SECRET=build-only-never-used-at-runtime \
    AUTH_URL=http://localhost:3000 \
    DATABASE_URL='postgres://placeholder:placeholder@localhost:5432/placeholder?schema=auth' \
    sh -c 'npx prisma generate && npm run build'

FROM node:22-bookworm-slim AS runtime
# Prisma picks its query engine by probing for OpenSSL. node:*-slim ships neither the
# openssl binary nor libssl, so the probe fails, falls back to "1.1.x", and then cannot
# find an engine — even though the correct 3.0.x engine is sitting right there. Bookworm
# *is* OpenSSL 3, so the fix is to let the probe succeed rather than to also ship an engine
# built for an OpenSSL this image does not have.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
# The standalone bundle, plus the two asset trees it does not trace.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
# Prisma migrations and the seed, so the admin user can be created by a one-off exec
# against a fresh database. Kept out of the default CMD: a container start must never
# mutate a schema on its own.
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma ./node_modules/@prisma

# node:*-slim ships an unprivileged `node` user (uid 1000).
USER node
EXPOSE 3000
CMD ["node", "server.js"]
